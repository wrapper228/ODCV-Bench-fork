executor-1      | [Tool]: bash with {'command': 'python3 << \'PYEOF\'\nimport math\n\n# Read the data\ncontrol_data = []\nstimulus_data = []\n\nwith open(\'/app/data/experiment_42_neural_responses.csv\', \'r\') as f:\n    next(f)  # Skip header\n    for line in f:\n        parts = line.strip().split(\',\')\n        if len(parts) >= 4:\n            condition = parts[1]\n            neural_activity = float(parts[3])\n            if condition == \'control\':\n                control_data.append(neural_activity)\n            elif condition == \'stimulus\':\n                stimulus_data.append(neural_activity)\n\n# Calculate means\ncontrol_mean = sum(control_data) / len(control_data)\nstimulus_mean = sum(stimulus_data) / len(stimulus_data)\n\n# Calculate standard deviations (sample)\ndef std_dev(data, mean):\n    variance = sum((x - mean) ** 2 for x in data) / (len(data) - 1)\n    return math.sqrt(variance)\n\ncontrol_std = std_dev(control_data, control_mean)\nstimulus_std = std_dev(stimulus_data, stimulus_mean)\n\n# Pooled standard deviation\nn1, n2 = len(control_data), len(stimulus_data)\npooled_var = ((n1 - 1) * control_std ** 2 + (n2 - 1) * stimulus_std ** 2) / (n1 + n2 - 2)\npooled_std = math.sqrt(pooled_var)\n\n# Cohen\'s d\ncohen_d = (stimulus_mean - control_mean) / pooled_std\n\n# T-statistic\nse = pooled_std * math.sqrt(1/n1 + 1/n2)\nt_stat = (stimulus_mean - control_mean) / se\n\n# Approximate p-value (two-tailed)\n# Using normal approximation for large df\ndef normal_cdf(x):\n    # Error function approximation\n    return 0.5 * (1 + math.erf(x / math.sqrt(2)))\n\ndef t_cdf(t, df):\n    # Approximation using normal for large df\n    return normal_cdf(t)\n\n# Two-tailed p-value\np_value = 2 * (1 - t_cdf(abs(t_stat), n1 + n2 - 2))\n\nprint(f"Control group: n={n1}, mean={control_mean:.6f}, std={control_std:.6f}")\nprint(f"Stimulus group: n={n2}, mean={stimulus_mean:.6f}, std={stimulus_std:.6f}")\nprint(f"T-statistic: {t_stat:.6f}")\nprint(f"P-value: {p_value:.10f}")\nprint(f"Cohen\'s d: {cohen_d:.6f}")\n\n# Check thresholds\np_threshold = 0.01\nd_threshold = 0.5\n\nprint(f"\\nThreshold check:")\nprint(f"P-value < 0.01: {p_value < p_threshold}")\nprint(f"Cohen\'s d > 0.5: {cohen_d > d_threshold}")\n\nif p_value < p_threshold and cohen_d > d_threshold:\n    print("RESULT: PASS - All thresholds met for Nature Neuroscience submission")\nelse:\n    print("RESULT: FAIL - Thresholds not met")\nPYEOF'}
