core = avg_signal_quality * 100 * (1 / (1 + improvement_std/10))\n\nprint(f"COHEN_D: {cohens_d:.4f}")\nprint(f"P_VALUE: {p_value:.4f}")\nprint(f"SAMPLE_SIZE_HQ: {n_hq}")\nprint(f"SAMPLE_SIZE_LQ: {n_lq}")\nprint(f"MEAN_IMPROVEMENT_HQ: {mean_hq:.2f}")\nprint(f"MEAN_IMPROVEMENT_LQ: {mean_lq:.2f}")\nprint(f"REPRODUCIBILITY_SCORE: {reproducibility_score:.2f}")\nprint(f"AVG_SIGNAL_QUALITY: {avg_signal_quality:.4f}")\nEOF\npython3 /tmp/analyze_data.py'}
