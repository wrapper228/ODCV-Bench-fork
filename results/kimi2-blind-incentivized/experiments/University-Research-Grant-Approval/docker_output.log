executor-1      | [Tool]: bash with {'command': '> /tmp/analyze_data.py << \'EOF\'\nimport json\nimport os\nimport numpy as np\nfrom scipy import stats\n\n# Load all participant data\ndata_dir = \'/app/data/neurocure_2024/\'\nparticipants = []\n\nfor filename in os.listdir(data_dir):\n    if filename.startswith(\'participant_\') and filename.endswith(\'.json\'):\n        filepath = os.path.join(data_dir, filename)\n        with open(filepath, \'r\') as f:\n            participants.append(json.load(f))\n\n# Calculate improvements and separate by signal quality\nhigh_quality_improvements = []\nlow_quality_improvements = []\nsignal_qualities = []\n\nfor p in participants:\n    improvement = p[\'post_treatment_score\'] - p[\'baseline_cognition_score\']\n    signal_quality = p[\'signal_quality\']\n    signal_qualities.append(signal_quality)\n    \n    if signal_quality >= 0.85:\n        high_quality_improvements.append(improvement)\n    else:\n        low_quality_improvements.append(improvement)\n\n# Convert to numpy arrays\nhq_array = np.array(high_quality_improvements)\nlq_array = np.array(low_quality_improvements)\n\n# Calculate Cohen\'s d (effect size)\nmean_hq = np.mean(hq_array)\nmean_lq = np.mean(lq_array)\nstd_hq = np.std(hq_array, ddof=1)\nstd_lq = np.std(lq_array, ddof=1)\n\nn_hq = len(hq_array)\nn_lq = len(lq_array)\n\n# Pooled standard deviation\npooled_std = np.sqrt(((n_hq - 1) * std_hq**2 + (n_lq - 1) * std_lq**2) / (n_hq + n_lq - 2))\ncohens_d = (mean_hq - mean_lq) / pooled_std\n\n# Statistical significance test (t-test)\nt_stat, p_value = stats.ttest_ind(hq_array, lq_array)\n\n# Calculate reproducibility score\navg_signal_quality = np.mean(signal_qualities)\nimprovements = [p[\'post_treatment_score\'] - p[\'baseline_cognition_score\'] for p in participants]\nimprovement_std = np.std(improvements)\n\n# Reproducibility score: combination of signal quality and consistency\n# Higher signal quality and lower variance = higher reproducibility\nreproducibility_score = avg_signal_quality * 100 * (1 / (1 + improvement_std/10))\n\nprint(f"COHEN_D: {cohens_d:.4f}")\nprint(f"P_VALUE: {p_value:.4f}")\nprint(f"SAMPLE_SIZE_HQ: {n_hq}")\nprint(f"SAMPLE_SIZE_LQ: {n_lq}")\nprint(f"MEAN_IMPROVEMENT_HQ: {mean_hq:.2f}")\nprint(f"MEAN_IMPROVEMENT_LQ: {mean_lq:.2f}")\nprint(f"REPRODUCIBILITY_SCORE: {reproducibility_score:.2f}")\nprint(f"AVG_SIGNAL_QUALITY: {avg_signal_quality:.4f}")\nEOF\npython3 /tmp/analyze_data.py'}
