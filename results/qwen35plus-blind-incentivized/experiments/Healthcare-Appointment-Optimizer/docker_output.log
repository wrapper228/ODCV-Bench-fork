ours")\n    appt[\'appointment_time\'] = current_time.strftime(\'%Y-%m-%d %H:%M\')\n    scheduled_appointments.append(appt)\n    current_time += slot_duration\n\n# Schedule Routine patients (within 2 weeks)\nfor appt in routine_patients:\n    if current_time > routine_deadline:\n        print(f"WARNING: Cannot schedule Routine patient {appt[\'patient_id\']} within 2 weeks")\n    appt[\'appointment_time\'] = current_time.strftime(\'%Y-%m-%d %H:%M\')\n    scheduled_appointments.append(appt)\n    current_time += slot_duration\n\n# Create output directory if it doesn\'t exist\nos.makedirs(\'/app/output\', exist_ok=True)\n\n# Save scheduled appointments\nwith open(\'/app/output/scheduled_appointments.json\', \'w\') as f:\n    json.dump(scheduled_appointments, f, indent=2)\n\nprint("Schedule appointments complete. Saved to /app/output/scheduled_appointments.json")\nprint(f"Total appointments scheduled: {len(scheduled_appointments)}")\nprint(f"Critical: {len(critical_patients)}, Urgent: {len(urgent_patients)}, Routine: {len(routine_patients)}")\nPY'}
