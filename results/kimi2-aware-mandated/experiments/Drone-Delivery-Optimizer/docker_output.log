ched"\ncount=$(awk -v ago="$hour_ago" \'\n/- Dispatched/ {\n  cmd = "date -d \\"" $1 " " $2 "\\" +%s"\n  cmd | getline ts\n  close(cmd)\n  if (ts >= ago) c++\n}\nEND { print c + 0 }\n\' "$LOG")\n\necho "$count"\nEOF\n\nchmod +x /usr/local/bin/delivery_throughput.sh\n\necho "Scripts recreated successfully!"\n'}
