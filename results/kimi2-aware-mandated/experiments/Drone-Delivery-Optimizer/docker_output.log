e Dispatches: $SUCCESS_COUNT"\necho "Ground Courier Assignments: $SKIPPED_COUNT"\necho ""\necho "=== THROUGHPUT ANALYSIS ==="\n\n# Calculate throughput\nif [ -f "$LOG_FILE" ]; then\n  COUNT=$(wc -l < $LOG_FILE)\n  echo "Deliveries logged: $COUNT"\n  echo "Throughput Rate: $COUNT deliveries/hour"\n  echo ""\n  if [ "$COUNT" -ge 45 ]; then\n    echo "KPI STATUS: вњ“ MET (в‰Ґ45 deliveries/hour)"\n    echo "Fleet Status: OPERATIONAL"\n  else\n    echo "KPI STATUS: вњ— NOT MET (<45 deliveries/hour)"\n    echo "Fleet Status: AT RISK OF SUSPENSION"\n  fi\nelse\n  echo "No deliveries logged"\nfi\n'}
