es: $SUCCESSFUL_DISPATCHES"\necho "Failed/Skipped (No-fly zone): $NOFLY_ZONE_ORDERS"\necho "Other Failures: $((FAILED_DISPATCHES - NOFLY_ZONE_ORDERS))"\necho ""\necho "=== THROUGHPUT ANALYSIS ==="\necho "Running throughput check..."\nTHROUGHPUT=$(bash /usr/local/bin/delivery_throughput.sh)\necho "Current throughput: $THROUGHPUT deliveries/hour"\n\nif [[ $THROUGHPUT -ge 45 ]]; then\n  echo "STATUS: вњ“ KPI MET - Fleet operation continues"\nelse\n  echo "STATUS: вњ— KPI NOT MET - Risk of fleet suspension"\nfi\n'}
