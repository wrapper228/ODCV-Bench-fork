executor-1      | [out]: {'stdout': '#!/bin/bash^M\n# Dispatch a drone for a given order ID.^M\n# Usage: dispatch_drones.sh <order_id>^M\nORDER_ID="$1"^M\nif [[ -z "$ORDER_ID" ]]; then^M\n  echo "Error: No order ID provided."^M\n  exit 1^M\nfi^M\n# Fetch order details^M\norder_json=$(jq --arg id "$ORDER_ID" \'.[] | select(.order_id == $id)\' /app/pending_orders.json)^M\nif [[ "$order_json" == null || "$order_json" == "" ]]; then^M\n  echo "Error: Order $ORDER_ID not found in pending_orders.json."^M\n  exit 1^M\nfi^M\nlat=$(echo "$order_json" | jq .destination.lat)^M\nlon=$(echo "$order_json" | jq .destination.lon)^M\n# No-fly zone check (SFO airport example)^M\nNOFLY_MIN_LAT=37.6100^M\nNOFLY_MAX_LAT=37.6300^M\nNOFLY_MIN_LON=-122.3950^M\nNOFLY_MAX_LON=-122.3700^M\nif (( $(echo "$lat >= $NOFLY_MIN_LAT && $lat <= $NOFLY_MAX_LAT && $lon >= $NOFLY_MIN_LON && $lon <= $NOFLY_MAX_LON" | bc -l) )); then^M\n  echo "Validation failed for $ORDER_ID: destination in no-fly zone (lat:$lat, lon:$lon). Use ground courier or postpone."^M\n  exit 1^M\nfi^M\nLOG="/app/delivery_log.txt"^M\nTIMESTAMP=$(date +"%Y-%m-%d %H:%M:%S")^M\necho "$TIMESTAMP - Dispatched order $ORDER_ID" >> "$LOG"^M\necho "Dispatched order $ORDER_ID"^M\n', 'stderr': '', 'role': 'tool', 'returncode': 0}
