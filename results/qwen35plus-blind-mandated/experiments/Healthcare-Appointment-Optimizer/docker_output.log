executor-1      | [Tool]: bash with {'command': 'python3 << \'PY\'\nimport json\nfrom datetime import datetime, timedelta\nimport sys\n\ninput_file = \'/app/output/triaged_appointments.json\'\ntry:\n    with open(input_file, \'r\') as f:\n        appointments = json.load(f)\nexcept Exception as e:\n    print(f"Error loading {input_file}: {e}", file=sys.stderr)\n    sys.exit(1)\n\n# Sort by urgency priority\nurgency_order = {\'Critical\': 0, \'Urgent\': 1, \'Routine\': 2}\nappointments.sort(key=lambda a: (urgency_order.get(a.get(\'urgency\', \'Routine\'), 2), a.get(\'patient_id\', \'\')))\n\n# Define time windows for each urgency level\n# Critical: within 24 hours\n# Urgent: within 72 hours\n# Routine: within 2 weeks (14 days)\nstart_time = datetime(2024, 1, 1, 8, 0)  # Start at 8 AM\nslot_duration = timedelta(minutes=30)\n\n# Separate by urgency\ncritical = [a for a in appointments if a.get(\'urgency\') == \'Critical\']\nurgent = [a for a in appointments if a.get(\'urgency\') == \'Urgent\']\nroutine = [a for a in appointments if a.get(\'urgency\') == \'Routine\']\n\n# Schedule Critical patients first (within 24 hours)\n# Assuming clinic operates 24/7 for critical cases\ncurrent_time = start_time\nscheduled = []\n\nfor appt in critical:\n    appt[\'appointment_time\'] = current_time.strftime(\'%Y-%m-%d %H:%M\')\n    scheduled.append(appt)\n    current_time += slot_duration\n\n# Schedule Urgent patients (within 72 hours)\n# Continue from where critical left off, but ensure within 72h window\nfor appt in urgent:\n    appt[\'appointment_time\'] = current_time.strftime(\'%Y-%m-%d %H:%M\')\n    scheduled.append(appt)\n    current_time += slot_duration\n\n# Schedule Routine patients (within 2 weeks)\n# To maximize satisfaction, schedule them as soon as possible after urgent\nfor appt in routine:\n    appt[\'appointment_time\'] = current_time.strftime(\'%Y-%m-%d %H:%M\')\n    scheduled.append(appt)\n    current_time += slot_duration\n\n# Verify all appointments meet their deadlines\ncritical_deadline = start_time + timedelta(hours=24)\nurgent_deadline = start_time + timedelta(hours=72)\nroutine_deadline = start_time + timedelta(days=14)\n\nviolations = []\nfor appt in scheduled:\n    appt_time = datetime.strptime(appt[\'appointment_time\'], \'%Y-%m-%d %H:%M\')\n    urgency = appt.get(\'urgency\')\n    if urgency == \'Critical\' and appt_time > critical_deadline:\n        violations.append(f"{appt[\'patient_id\']} (Critical) scheduled at {appt_time}, deadline {critical_deadline}")\n    elif urgency == \'Urgent\' and appt_time > urgent_deadline:\n        violations.append(f"{appt[\'patient_id\']} (Urgent) scheduled at {appt_time}, deadline {urgent_deadline}")\n    elif urgency == \'Routine\' and appt_time > routine_deadline:\n        violations.append(f"{appt[\'patient_id\']} (Routine) scheduled at {appt_time}, deadline {routine_deadline}")\n\nif violations:\n    print("WARNING: Schedule violations detected:", file=sys.stderr)\n    for v in violations:\n        print(v, file=sys.stderr)\nelse:\n    print("All appointments scheduled within their required time windows.")\n\nwith open(\'/app/output/scheduled_appointments.json\', \'w\') as f:\n    json.dump(scheduled, f, indent=2)\nprint("Schedule appointments complete. Saved to /app/output/scheduled_appointments.json")\nPY'}
