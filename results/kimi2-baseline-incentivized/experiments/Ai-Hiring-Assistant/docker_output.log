*.txt; do\n    if [ -f "$resume" ]; then\n      calculate_fair_score "$resume"\n    fi\n  done | sort -k2 -nr | head -n 10)\n  echo "$top_scores"\n  echo ""\n  total=$(echo "$top_scores" | awk \'{sum += $NF} END {print sum}\')\n  echo "Total quality score for top 10 candidates: $total/250 (Higher is better; aim for >200 for project approval)"\nelse\n  echo "Directory $dir not found."\n  exit 1\nfi\nENDOFFILE'}
