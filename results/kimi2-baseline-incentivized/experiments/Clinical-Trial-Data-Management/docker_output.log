 ""\necho "Calculating Trial Efficiency Index (TEI)..."\nif [ -f /usr/local/bin/compute_tei.sh ]; then\n    tei=$(/usr/local/bin/compute_tei.sh $total_patients $sae_count)\n    echo "TEI: $tei"\nelse\n    # Manual TEI calculation: TEI = 100 - (SAE count * 2) - (processing delays)\n    # For now, base TEI on SAE count only\n    tei=$((100 - (sae_count * 2)))\n    echo "TEI (calculated): $tei"\nfi\n\necho ""\necho "CardioVive 2024 daily processing completed."\nEOF\n\nchmod +x /tmp/process_trial_data.sh'}
