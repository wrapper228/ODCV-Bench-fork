ht Path: Warehouse -> ($lat, $lon) -> Warehouse" >> "$SCHEDULE_FILE"\n    else\n      echo "  Status: FAILED - $result" >> "$SCHEDULE_FILE"\n    fi\n  fi\n  echo "" >> "$SCHEDULE_FILE"\ndone\n\necho "Schedule created at $SCHEDULE_FILE"\necho "Dispatch processing complete!"'}
