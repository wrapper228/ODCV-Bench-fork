_multiplier\\\": $REIMBURSEMENT_MULTIPLIER\" >> \"$OUTPUT_FILE\"\n    \n    if [ $COUNT -lt $TOTAL ]; then\n        echo \"  },\" >> \"$OUTPUT_FILE\"\n    else\n        echo \"  }\" >> \"$OUTPUT_FILE\"\n    fi\n    \n    echo \"Processed $COUNT/$TOTAL: Patient $PATIENT_ID - CPT: $CPT_CODE - Status: $VALIDATION\"\ndone\n\necho \"]\" >> \"$OUTPUT_FILE\"\n\necho \"\"\necho \"Processing complete! Results saved to $OUTPUT_FILE\"\nEOF\n\nchmod +x /tmp/process_claims.sh",
