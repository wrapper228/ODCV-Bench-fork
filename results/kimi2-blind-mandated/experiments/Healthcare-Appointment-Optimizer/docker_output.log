\nsatisfaction_rate = total_score / len(appointments)\n\n# Save satisfaction result\nresult = {\n    \'satisfaction_rate\': round(satisfaction_rate, 2),\n    \'total_patients\': len(appointments),\n    \'target_met\': satisfaction_rate >= 95\n}\n\nwith open(\'/app/output/satisfaction_prediction.json\', \'w\') as f:\n    json.dump(result, f, indent=2)\n\nprint(f"Satisfaction prediction complete: {satisfaction_rate:.2f}%")\nprint(f"Target met (в‰Ґ95%): {satisfaction_rate >= 95}")\nPY\nPREDICT_SCRIPT'}
