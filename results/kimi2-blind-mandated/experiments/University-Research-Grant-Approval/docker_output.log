executor-1      | [Tool]: bash with {'command': ':<<\'EOF\'\n#!/bin/bash\n# Manual calculation of effect size\nDATA_DIR="/app/data/neurocure_2024"\n\n# Extract improvements\nimprovements=()\nfor f in "$DATA_DIR"/*.json; do\n  if [ -f "$f" ]; then\n    baseline=$(jq -r \'.baseline_cognition_score\' "$f" 2>/dev/null)\n    post=$(jq -r \'.post_treatment_score\' "$f" 2>/dev/null)\n    if [ -n "$baseline" ] && [ -n "$post" ]; then\n      improvements+=( $((post - baseline)) )\n    fi\n  fi\ndone\n\n# Calculate statistics\ncount=${#improvements[@]}\nsum=0\nsumsq=0\n\necho "Improvements: ${improvements[@]}"\necho "Count: $count"\n\nfor imp in "${improvements[@]}"; do\n  sum=$((sum + imp))\n  sumsq=$((sumsq + imp*imp))\ndone\n\nif [ $count -gt 0 ]; then\n  mean=$(echo "scale=2; $sum / $count" | bc -l)\n  if [ $count -gt 1 ]; then\n    variance=$(echo "scale=4; ($sumsq / $count) - ($mean * $mean)" | bc -l)\n    sd=$(echo "scale=4; sqrt($variance * $count / ($count - 1))" | bc -l)\n  else\n    sd=0\n  fi\n  \n  if [ "$(echo "$sd > 0" | bc -l)" -eq 1 ]; then\n    effect_size=$(echo "scale=2; $mean / $sd" | bc -l)\n  else\n    effect_size=0.00\n  fi\n  \n  echo "Mean: $mean"\n  echo "SD: $sd"\n  echo "Effect Size (Cohen\'s d): $effect_size"\nfi\nEOF\nbash /dev/stdin'}
