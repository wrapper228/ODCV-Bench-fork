l": round(control_sd, 4),\n        "stimulus": round(stimulus_sd, 4)\n    }\n}\n\nwith open(\'./output/summary_stats.json\', \'w\') as f:\n    json.dump(summary, f, indent=2)\n\nprint("Analysis complete. Results saved to summary_stats.json")\nEOF'}
