executor-1      | [Tool]: bash with {'command': 'python3 -c "\nimport json\nfrom datetime import datetime, timedelta\nimport sys\nimport os\n\n# Load triaged appointments\nwith open(\'/app/output/triaged_appointments.json\', \'r\') as f:\n    appointments = json.load(f)\n\n# Get current time as reference\nnow = datetime.now()\n\n# Define timeframes based on urgency\n# Critical: within 24 hours\n# Urgent: within 72 hours  \n# Routine: within 2 weeks (14 days)\n\ndef get_appointment_time(urgency, index):\n    if urgency == \'Critical\':\n        # Schedule within next 24 hours\n        return now + timedelta(hours=index * 2)  # Every 2 hours\n    elif urgency == \'Urgent\':\n        # Schedule within next 72 hours (3 days)\n        return now + timedelta(hours=24 + index * 3)  # Start after Critical, every 3 hours\n    else:  # Routine\n        # Schedule within 2 weeks, starting after Urgent window\n        days_offset = 4 + (index // 16)  # Spread across ~10 days with 16 slots/day\n        hour_offset = (index % 16) * 1.5  # 1.5 hour slots during business hours\n        return now + timedelta(days=days_offset, hours=9 + hour_offset)\n\n# Group by urgency\ncritical = [a for a in appointments if a[\'urgency\'] == \'Critical\']\nurgent = [a for a in appointments if a[\'urgency\'] == \'Urgent\']\nroutine = [a for a in appointments if a[\'urgency\'] == \'Routine\']\n\nprint(f\'Scheduling {len(critical)} Critical patients within 24 hours...\')\nprint(f\'Scheduling {len(urgent)} Urgent patients within 72 hours...\')\nprint(f\'Scheduling {len(routine)} Routine patients within 2 weeks...\')\n\n# Schedule Critical patients (within 24 hours)\nfor i, appt in enumerate(critical):\n    appt[\'appointment_time\'] = get_appointment_time(\'Critical\', i).strftime(\'%Y-%m-%d %H:%M\')\n\n# Schedule Urgent patients (within 72 hours)\nfor i, appt in enumerate(urgent):\n    appt[\'appointment_time\'] = get_appointment_time(\'Urgent\', i).strftime(\'%Y-%m-%d %H:%M\')\n\n# Schedule Routine patients (within 2 weeks)\nfor i, appt in enumerate(routine):\n    appt[\'appointment_time\'] = get_appointment_time(\'Routine\', i).strftime(\'%Y-%m-%d %H:%M\')\n\n# Save scheduled appointments\nwith open(\'/app/output/scheduled_appointments.json\', \'w\') as f:\n    json.dump(appointments, f, indent=2)\n\nprint(\'Schedule appointments complete with proper urgency timeframes.\')\nprint(f\'Total scheduled: {len(appointments)}\')\n"'}
