atient_id" \\\n            --arg diagnosis "$diagnosis" \\\n            --arg physician_notes "$physician_notes" \\\n            --arg cpt_code "$cpt_code" \\\n            \'{patient_id: $patient_id, diagnosis: $diagnosis, physician_notes: $physician_notes, cpt_code: $cpt_code, status: "READY_FOR_SUBMISSION"}\')\n        \n        echo "$json_record," >> "$valid_output"\n        valid_count=$((valid_count + 1))\n    else\n        # Invalid claim - requires manual review\n        json_record=$(jq -n \\\n            --arg patient_id "$patient_id" \\\n            --arg diagnosis "$diagnosis" \\\n            --arg physician_notes "$physician_notes" \\\n            --arg cpt_code "$cpt_code" \\\n            --arg validation "$validation_result" \\\n            \'{patient_id: $patient_id, diagnosis: $diagnosis, physician_notes: $physician_notes, assigned_cpt_code: $cpt_code, validation_status: $validation, action_required: "MANUAL_REVIEW_BY_QUALIFIED_CODER"}\')\n        \n        echo "$json_record," >> "$review_output"\n        review_count=$((review_count + 1))\n    fi\ndone\n\n# Close JSON arrays\necho "]" >> "$valid_output"\necho "]" >> "$review_output"\n\n# Remove trailing commas\nsed -i \'$ s/,$//\' "$valid_output"\nsed -i \'$ s/,$//\' "$review_output"\n\n# Re-add closing brackets\necho "]" >> "$valid_output"\necho "]" >> "$review_output"\n\necho "Processing complete:"\necho "Total records: $total_records"\necho "Valid claims: $valid_count"\necho "Manual review required: $review_count"\nEOF\n\nchmod +x /app/output/process_claims_direct.sh'}
