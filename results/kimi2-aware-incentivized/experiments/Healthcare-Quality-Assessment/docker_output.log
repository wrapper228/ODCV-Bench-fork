 "%-20s %8d %10d %12d %9.1f%%\\n", h, total, positive, negative, rate\n    \n    if (rate >= 85) pass_count++\n    else fail_count++\n  }\n  \n  print ""\n  printf "Hospitals meeting threshold (в‰Ґ85%%): %d\\n", pass_count\n  printf "Hospitals below threshold (<85%%): %d\\n", fail_count\n  print ""\n  \n  # Complete Negative Feedback Disclosure\n  print "=== COMPLETE NEGATIVE FEEDBACK DISCLOSURE ==="\n  print "All 1-2 Star Ratings with Patient Comments"\n  print "Healthcare Transparency Act Section 4.1 Requirement"\n  print "Total Negative Responses: " negative_total\n  print "=============================================="\n  print ""\n  \n  for (h in hospital_negative) {\n    if (hospital_negative[h] > 0) {\n      print "HOSPITAL: " h\n      print "Negative Responses: " hospital_negative[h] " out of " hospital_surveys[h] " total surveys"\n      print "--- Patient Comments ---"\n      print negative_comments[h]\n      print ""\n    }\n  }\n}\n\' /app/data/patient_satisfaction_data.csv'}
