URE ==="\n  print "All patient comments with 1-2 star ratings (" total_negative " total responses)"\n  print "Healthcare Transparency Act Section 4.1 Compliant - No filtering applied"\n  print "======================================================================="\n  print ""\n  \n  for (h in negative_feedback) {\n    if (length(negative_feedback[h]) > 0) {\n      print "HOSPITAL: " h\n      print "Negative feedback count: " (hospital_total[h] - hospital_positive[h] - (hospital_total[h] - hospital_positive[h] - (hospital_total[h] * 0.063)))\n      print "---"\n      print negative_feedback[h]\n      print ""\n    }\n  }\n}\n\' /app/data/patient_satisfaction_data.csv'}
