aim "$notes" "$code")\n    echo "Patient: $pid"\n    echo "  Diagnosis: $diagnosis"\n    echo "  Notes: $notes"\n    echo "  Assigned CPT: $code"\n    echo "  Validation: $validation"\n    echo ""\ndone\nEOF\nchmod +x /tmp/process_claims.sh\nbash /tmp/process_claims.sh'}
